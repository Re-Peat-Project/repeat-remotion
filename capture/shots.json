{
  "_readme": "What to capture from the dashboard. `page` is an app route ({khg} = profileKhg). `block` shoots the panel under a heading (Bahasa text, start of the heading). Run: npm run capture (all) or npm run capture -- <id> <id>.",
  "baseUrl": "https://re-peat-project.github.io/repeat-dashboard/",
  "lang": "id",
  "theme": "light",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "scale": 2,
  "profileKhg": "62.11-14.02",
  "stills": [
    {
      "id": "nat-top",
      "page": "#/",
      "target": "viewport"
    },
    {
      "id": "nat-fire",
      "page": "#/",
      "block": "Situasi kebakaran"
    },
    {
      "id": "nat-trends",
      "page": "#/",
      "block": "Tren kebakaran"
    },
    {
      "id": "nat-province",
      "page": "#/",
      "block": "Menurut provinsi"
    },
    {
      "id": "water-top",
      "page": "#/?v=water",
      "target": "viewport"
    },
    {
      "id": "water-weekly",
      "page": "#/?v=water",
      "block": "Titik panas dan muka air mingguan"
    },
    {
      "id": "water-region",
      "page": "#/?v=water",
      "block": "Muka air tanah menurut wilayah"
    },
    {
      "id": "prio-top",
      "page": "#/priority",
      "target": "viewport"
    },
    {
      "id": "prio-map-type",
      "page": "#/priority",
      "target": ".maplibregl-map"
    },
    {
      "id": "prio-map-urgency",
      "page": "#/priority",
      "actions": [
        {
          "click": "button:text-is('Urgensi')"
        },
        {
          "wait": 1500
        }
      ],
      "target": ".maplibregl-map"
    },
    {
      "id": "prio-map-intervention",
      "page": "#/priority",
      "actions": [
        {
          "click": "button:text-is('Intervensi')"
        },
        {
          "wait": 1500
        }
      ],
      "target": ".maplibregl-map"
    },
    {
      "id": "prio-types",
      "page": "#/priority",
      "block": "Tipe"
    },
    {
      "id": "prio-shift",
      "page": "#/priority",
      "block": "Perubahan peringkat"
    },
    {
      "id": "prio-weights",
      "page": "#/priority",
      "scrollTo": "#final-w",
      "target": "viewport"
    },
    {
      "id": "khg-top",
      "page": "#/khg/{khg}",
      "target": "viewport"
    },
    {
      "id": "khg-summary",
      "page": "#/khg/{khg}",
      "block": "Ringkasan keputusan",
      "blockMin": 250
    },
    {
      "id": "khg-kpis",
      "page": "#/khg/{khg}",
      "target": ".profile-kpis"
    },
    {
      "id": "khg-map",
      "page": "#/khg/{khg}",
      "target": "#khg-evidence-map"
    },
    {
      "id": "khg-map-depth",
      "page": "#/khg/{khg}",
      "actions": [
        {
          "click": "#khg-evidence-map summary:text-is('Lapisan peta lainnya')"
        },
        {
          "wait": 600
        },
        {
          "clickText": [
            "#khg-evidence-map button",
            "Kedalaman gambut"
          ]
        },
        {
          "wait": 2500
        }
      ],
      "target": "#khg-evidence-map"
    },
    {
      "id": "khg-map-damage",
      "page": "#/khg/{khg}",
      "actions": [
        {
          "click": "#khg-evidence-map summary:text-is('Lapisan peta lainnya')"
        },
        {
          "wait": 600
        },
        {
          "clickText": [
            "#khg-evidence-map button",
            "Kerusakan (SKEG)"
          ]
        },
        {
          "wait": 2500
        }
      ],
      "target": "#khg-evidence-map"
    },
    {
      "id": "khg-map-canal",
      "page": "#/khg/{khg}",
      "actions": [
        {
          "click": "#khg-evidence-map summary:text-is('Lapisan peta lainnya')"
        },
        {
          "wait": 600
        },
        {
          "clickText": [
            "#khg-evidence-map button",
            "Zona kanal"
          ]
        },
        {
          "wait": 2500
        }
      ],
      "target": "#khg-evidence-map"
    },
    {
      "id": "khg-map-satellite",
      "page": "#/khg/{khg}",
      "actions": [
        {
          "clickText": [
            "#khg-evidence-map button",
            "Satelit"
          ]
        },
        {
          "wait": 3500
        }
      ],
      "target": "#khg-evidence-map"
    },
    {
      "id": "khg-fire",
      "page": "#/khg/{khg}",
      "block": "Riwayat kebakaran",
      "blockMin": 400
    },
    {
      "id": "khg-landstatus",
      "page": "#/khg/{khg}",
      "block": "Status lahan di gambut"
    },
    {
      "id": "table-top",
      "page": "#/table",
      "target": "viewport"
    }
  ],
  "clips": [
    {
      "id": "clip-weights",
      "page": "#/priority",
      "scrollTo": "#final-w",
      "actions": [
        {
          "wait": 1500
        },
        {
          "slide": [
            "#final-w [role=slider] >> nth=0",
            0,
            1,
            50
          ]
        },
        {
          "wait": 2500
        },
        {
          "slide": [
            "#final-w [role=slider] >> nth=3",
            0,
            1,
            50
          ]
        },
        {
          "wait": 2500
        },
        {
          "slide": [
            "#final-w [role=slider] >> nth=0",
            0,
            0.3,
            40
          ]
        },
        {
          "wait": 4000
        }
      ]
    }
  ],
  "stats": [
    {
      "id": "national",
      "page": "#/table",
      "selector": ".sumrow .kpi",
      "value": ".v"
    },
    {
      "id": "fire",
      "page": "#/",
      "selector": "dl.card > div",
      "value": "dd"
    },
    {
      "id": "asOf",
      "page": "#/priority",
      "selector": ".pz p",
      "first": true
    }
  ]
}
